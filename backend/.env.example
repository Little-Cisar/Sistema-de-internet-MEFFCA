# API
PORT=3000
NODE_ENV=development

# Frontend React/Vite. Si el frontend usa otro puerto, cambiar este valor.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# SQL Server: escribe el servidor tal como lo configuraste en SSMS.
# Ejemplo instancia SQLEXPRESS: DB_SERVER=localhost y DB_INSTANCE=SQLEXPRESS
# Ejemplo instancia predeterminada: DB_SERVER=localhost y deja DB_INSTANCE vacío
DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
DB_PORT=1433
DB_NAME=MEFCCA_DB
DB_USER=mefcca_app
DB_PASSWORD=CAMBIAR_POR_LA_CLAVE_DEL_LOGIN_SQL
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Generar un secreto aleatorio de 48 bytes y pegarlo aquí; no compartirlo ni subir .env a Git.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=12

# Solo para crear el primer administrador local. Agregue valores temporalmente y elimínelos luego.
# INITIAL_ADMIN_EMAIL=admin@dominio.local
# INITIAL_ADMIN_PASSWORD=una-clave-larga-de-12-caracteres-minimo
