    {
      "name": "24 - Registrar venta concretada (Protagonista)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenProtagonista}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/ventas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"detalles\": [\n    {\n      \"id_producto\": \"{{productId}}\",\n      \"cantidad\": 1\n    }\n  ],\n  \"comprador_email\": \"cliente.prueba@example.com\",\n  \"metodo_pago\": \"Efectivo\",\n  \"metodo_entrega\": \"Entrega presencial\",\n  \"observaciones\": \"Operación de demostración previamente acordada\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Requiere protagonista verificado, un producto activo con al menos una unidad y una cuenta Cliente existente con el correo indicado. Cambie el correo de ejemplo si es necesario."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Venta registrada (201)', function () { pm.response.to.have.status(201); });",
              "const data = pm.response.json();",
              "if (data.venta && data.venta.id_venta) pm.collectionVariables.set('saleId', String(data.venta.id_venta));",
              "pm.test('La respuesta incluye la venta y total', function () { pm.expect(data.venta.id_venta).to.exist; pm.expect(data.venta.total).to.be.a('number'); });"
            ]
          }
        }
